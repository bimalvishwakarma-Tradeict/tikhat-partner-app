{
  "expo": {
    "name": "Tikhat Partner",
    "slug": "tikhat-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tikhatpartner",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1628",
      "imageWidth": 200
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "online.tikhatpartner.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Tikhat Partner needs camera access to upload KYC and payment screenshots.",
        "NSPhotoLibraryUsageDescription": "Tikhat Partner needs photo library access to upload documents and screenshots.",
        "NSFaceIDUsageDescription": "Tikhat Partner may use Face ID to protect your session."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1628"
      },
      "package": "online.tikhatpartner.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "primaryColor": "#0A1628"
  }
}
