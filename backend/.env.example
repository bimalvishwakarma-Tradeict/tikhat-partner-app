# Backend environment variables — copy to `.env` and fill in values.
# NEVER commit the real `.env` file.

# Runtime
NODE_ENV=development
PORT=5000

# PostgreSQL
DATABASE_URL=postgresql://tikhat:changeme@localhost:5432/tikhat_partner

# Auth (use long random secrets in production)
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Email (Resend.com)
RESEND_API_KEY=re_xxxxxxxx

# Google Drive backups — preferred (service account JSON path)
GOOGLE_DRIVE_SERVICE_ACCOUNT_PATH=/etc/tikhat/secrets/gdrive-service-account.json
# Optional alias (Google standard)
# GOOGLE_APPLICATION_CREDENTIALS=/etc/tikhat/secrets/gdrive-service-account.json

# Shared Drive folder ID for TikhatPartnerBackups (recommended)
GOOGLE_DRIVE_FOLDER_ID=

# Legacy OAuth (optional if service account is configured)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Backup encryption (required in production)
BACKUP_ENCRYPTION_KEY=change-me-32-char-minimum-secret!!

# App URLs / paths
FRONTEND_URL=https://tikhatpartner.online
UPLOAD_PATH=./uploads
BACKUP_PATH=./backups
LOG_PATH=./logs

# Super Admin seed (used by `npm run seed` only)
SUPER_ADMIN_EMAIL=superadmin@tikhatpartner.online
SUPER_ADMIN_PASSWORD=ChangeMe@123
SUPER_ADMIN_NAME=Super Admin

# Optional overrides
# OTP_EXPIRY_MINUTES=10
# EMAIL_RETRY_DELAY_MS=300000
# REVENUE_CREDIT_RETRY_DELAY_MS=300000
# PG_DUMP_PATH=pg_dump
# PG_DUMP_DOCKER_CONTAINER=
